<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_preview_bg"
    android:orientation="vertical"
    android:gravity="left|top"
    android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TODAY" android:textColor="#8AFFFFFF" android:textSize="11sp" android:layout_marginBottom="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Fajr"
            android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="5:12 AM" android:textColor="#8AFFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Sunrise"
            android:textColor="#4DFFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="6:38 AM" android:textColor="#4DFFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Dhuhr"
            android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="12:30 PM" android:textColor="#8AFFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/widget_preview_pill">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Asr"
            android:textColor="#6460FF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3:45 PM" android:textColor="#6460FF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Maghrib"
            android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="6:20 PM" android:textColor="#8AFFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Isha"
            android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="7:50 PM" android:textColor="#8AFFFFFF" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
